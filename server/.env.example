# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexora_food
CLIENT_URL=http://localhost:5173
JWT_SECRET=<long-random-string>
NODE_ENV=development

# ----- Only needed when published online -----
# Cloudinary stores product images (free plan). Leave empty on your own PC.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Several sites can be allowed, comma-separated: https://shop.vercel.app,https://www.yourshop.com
# NODE_ENV=production
# TRUST_PROXY=1
